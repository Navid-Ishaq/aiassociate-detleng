 "title":"Shared quiz and flashcard bank",
 "type":"array","minItems":12,"maxItems":20,
 "items":{"type":"object","required":["id","question","options","correct","explanation","feedback"],"properties":{"id":{"type":"string","pattern":"^M[0-9]{2}-L[0-9]{2}-Q[0-9]{3}$"},"question":{"type":"string","minLength":1},"options":{"type":"array","minItems":4,"maxItems":4,"uniqueItems":true,"items":{"type":"string","minLength":1}},"correct":{"type":"integer","minimum":0,"maximum":3},"explanation":{"type":"string","minLength":1},"feedback":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"string","minLength":1}}}}
