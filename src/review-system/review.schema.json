{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Lesson Quick Review",
 "type":"object",
 "required":["id","title","objective","items"],
 "properties":{
  "id":{"type":"string","pattern":"^M[0-9]{2}-L[0-9]{2}$"},
  "title":{"type":"string","minLength":1},
  "objective":{"type":"string","minLength":1},
  "items":{"type":"array","minItems":1,"maxItems":25,"items":{"type":"object","required":["id","question","answer"],"properties":{"id":{"type":"string","pattern":"^M[0-9]{2}-L[0-9]{2}-R[0-9]{3}$"},"question":{"type":"string","minLength":1},"answer":{"type":"string","minLength":1}}}}
 }
}
